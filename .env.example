# Copy values into your host configuration. No secrets are supplied here.
STEWARD_MODE=demo
ORIGIN=http://localhost:5173
PORT=3000
DATABASE_PATH=data/steward-demo.sqlite
# Public Railway demo only: set explicitly after generating the Railway domain.
# ORIGIN=https://${{RAILWAY_PUBLIC_DOMAIN}}
# STEWARD_PUBLIC_DEMO=true
# DATABASE_PATH=:memory:
# Live mode requires reviewed deployment configuration; no real deployments exist yet.
# STEWARD_SERVICE_KEY=<base64 32-byte key>
# STEWARD_MANIFEST_PATH=config/live-manifest.json
# STEWARD_RPC_URL=<Alchemy read RPC>
# STEWARD_RPC_FALLBACK_URL=<validated public read RPC>
# STEWARD_BACKUP_KEY=<separately secured base64 32-byte key>
# STEWARD_BACKUP_KEY_VERSION=v1

# Optional Resend channel, only after sender and recipient verification.
# STEWARD_EMAIL_API_KEY=<provider secret>
# STEWARD_EMAIL_FROM=<verified sender>
# STEWARD_EMAIL_RECIPIENTS_PATH=<private JSON account-id to verified email map>
# STEWARD_EMAIL_WEBHOOK_SECRET=<Svix signing secret>

# Optional in-process maintenance. Local backup storage is not offsite storage.
# STEWARD_MAINTENANCE_ENABLED=true
# STEWARD_BACKUP_DIRECTORY=/app/backups
# STEWARD_CLAMSCAN_PATH=/path/to/operator-installed/clamscan
